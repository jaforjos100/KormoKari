<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme using Material 3 / Dark theme matching KormoKari branding and Android system theme -->
    <style name="Theme.KormoKari" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/kormokari_navy</item>
        <item name="android:statusBarColor">@color/kormokari_navy</item>
        <item name="android:navigationBarColor">@color/kormokari_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/kormokari_primary</item>
    </style>

    <!-- AndroidX SplashScreen theme for Dark Theme: API 24+ compatible -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kormokari_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/kormokari_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.KormoKari</item>

        <item name="android:windowBackground">@color/kormokari_navy</item>
        <item name="android:statusBarColor">@color/kormokari_navy</item>
        <item name="android:navigationBarColor">@color/kormokari_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Compatibility alias -->
    <style name="Theme.MyApplication" parent="Theme.KormoKari" />
</resources>
