<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme using Material 3 / Light theme matching KormoKari branding -->
    <style name="Theme.KormoKari" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/kormokari_splash_background</item>
        <item name="android:statusBarColor">@color/kormokari_splash_background</item>
        <item name="android:navigationBarColor">@color/kormokari_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/kormokari_primary</item>
    </style>

    <!-- AndroidX SplashScreen theme: API 24+ compatible -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Soft off-white/pink brand background matching the Compose native splash and web overlay (#FBF9FB) -->
        <item name="windowSplashScreenBackground">@color/kormokari_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/kormokari_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.KormoKari</item>

        <!-- System bar and window background styling for seamless SplashScreen API transition -->
        <item name="android:windowBackground">@color/kormokari_splash_background</item>
        <item name="android:statusBarColor">@color/kormokari_splash_background</item>
        <item name="android:navigationBarColor">@color/kormokari_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Compatibility alias -->
    <style name="Theme.MyApplication" parent="Theme.KormoKari" />
</resources>
